# Project Oracle environment — copy to <repo>/.env and fill in.
# Read by the systemd web service (EnvironmentFile) and the cron jobs
# (sourced by run-job.sh). Keep values simple: NO quotes, NO spaces.

TZ=Asia/Kolkata

# glibc gives every thread its own malloc arena, so a threaded Python process
# reports an RSS well above what is actually live. Capping them trades a little
# allocator contention for real memory back — the right way round on a host under
# ~1GB. Set here rather than in the systemd units so it also reaches the cron
# jobs (run-job.sh exports this file), and the downloader is the hungriest of
# them. Remove it if you move to a box with room to spare.
MALLOC_ARENA_MAX=2

# First-run bootstrap only. Logins live in the database and are managed in the
# app (Setup > User Management); these two are used ONLY to create the first
# administrator on an empty database, so editing them later changes nothing.
# Rotate a password in the app, or on the host with:
#   python scripts/manage_users.py passwd <username>
# If the browser extension autofills the login, keep its
# extensions/oracle-login/config.js in step with whatever you set.
ORACLE_ADMIN_USER=senthil
ORACLE_ADMIN_PASSWORD=set-a-long-random-password

# How many days a "Keep me signed in" browser session lasts (default 3). The
# cookie is a bearer token: over plain HTTP anyone on the network path can read
# it, so shorten this (or put the app behind TLS) if that matters.
ORACLE_SESSION_DAYS=3

# Telegram alerts for Zerodha Trades (optional — leave blank to use email only).
# TELEGRAM_BOT_TOKEN comes from @BotFather; TELEGRAM_CHAT_ID is your own chat id
# (message the bot, then read it from
# https://api.telegram.org/bot<TOKEN>/getUpdates). Each group picks its own
# channels in Group Management; both are on by default.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail App Password (not your normal password) for notification emails
GMAIL_USER=you@gmail.com
GMAIL_PASS=your16charapppass

# Zerodha
ZERODHA_USER_ID=PC8006
# Kite password + TOTP secret now live in the DATABASE, per account, set on
# Setup > Zerodha Accounts and encrypted at rest. They drive the headless login
# (bees.bot relogin) that refreshes the enctoken at 8:10am IST when the stored
# one has expired.
#
# The two variables below are a fallback for a host that hasn't been migrated.
# Move them in with:
#   python -m migrations.move_zerodha_credentials
# then DELETE them from this file — leaving them here defeats the point.
# ZERODHA_PASSWORD=your-kite-password
# ZERODHA_TOTP_SECRET=YOURBASE32TOTPSECRET

# Key that encrypts the stored Kite password / TOTP secret. Leave unset and one
# is generated at data/secret.key (0600) on first use — that is fine, and keeps
# the key out of the nightly Google Drive backup of the database. Back the file
# up somewhere safe: without it those credentials must be re-entered.
# ORACLE_SECRET_KEY=

# --- enctoken ingest API (used by the Chrome extension) ---
# Basic-auth credentials the extension must send. Pick your own; they MUST
# match BASIC_USER / BASIC_PASS in the extension's popup.js.
ENCTOKEN_API_USER=oracle
ENCTOKEN_API_PASS=change-me-to-a-long-random-string
# Optional overrides (defaults shown):
# ENCTOKEN_API_PORT=8502
# ENCTOKEN_API_HOST=0.0.0.0
# ENCTOKEN_API_CORS_ORIGIN=https://kite.zerodha.com

# --- Everything below is OPTIONAL: these are the built-in defaults, and the
# --- relative paths resolve against the repo (the service/cron run there). ---
# DRIVE_ROOT_FOLDER=QuantData
# DRIVE_CREDENTIALS_PATH=credentials.json
# DRIVE_TOKEN_PATH=token.json
# DOWNLOADER_DATA_ROOT=data
# DOWNLOADER_KEEP_MONTHS=2
# DOWNLOADER_MAX_WORKERS=4
# DOWNLOADER_RAM_FLOOR_MB=200
# DOWNLOADER_RAM_PER_WORKER_MB=50
# DOWNLOADER_MIN_RAM_MB=20
# DOWNLOADER_MIN_FREE_DISK_MB=2000
