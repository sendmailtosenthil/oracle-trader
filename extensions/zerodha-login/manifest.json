{
  "manifest_version": 3,
  "name": "Zerodha Kite Auto-Login",
  "version": "1.3.0",
  "description": "One click: opens Kite, logs in with this browser's account (user id, password, time-based OTP) and syncs the enctoken to Project Oracle.",
  "permissions": ["tabs", "storage", "cookies", "contextMenus"],
  "host_permissions": [
    "https://kite.zerodha.com/*",
    "http://129.159.236.137:8502/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Zerodha Kite Auto-Login",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://kite.zerodha.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
