// Copy this file to `config.js` and fill in your Kite account(s).
// `config.js` is gitignored so your real secrets are never committed.
//
// List every account you use here — this file is the only place they are
// defined. Each browser is then attached to ONE of them: the first time you
// click the Z icon in a browser it asks which account that browser is for
// (skipped when there's only one), and after that the icon just logs in.
// The choice is stored per browser profile, so 3 browsers can each use a
// different account off this same list.
self.KITE_ACCOUNTS = [
  // { user: "PC8006", pass: "YOUR_KITE_PASSWORD", secret: "YOUR_TOTP_SECRET_BASE32" },
  // { user: "ZD2461", pass: "...", secret: "..." },
];

// A single account (legacy form) still works too:
// self.KITE_CREDS = { user: "PC8006", pass: "...", secret: "..." };

// --- Project Oracle server ---------------------------------------------------
// Where to push the enctoken after every Kite login. Must match the enctoken
// API's .env (ENCTOKEN_API_USER / ENCTOKEN_API_PASS). Leave this out entirely
// and the extension just logs you in without syncing.
//
// The host must also appear in manifest.json `host_permissions` — a Chrome
// extension can only call hosts listed there.
self.ORACLE_API = {
  base: "http://YOUR_VPS_HOST:8502", // no trailing slash
  user: "oracle", // == ENCTOKEN_API_USER on the server
  pass: "YOUR_ENCTOKEN_API_PASS", // == ENCTOKEN_API_PASS on the server
};
